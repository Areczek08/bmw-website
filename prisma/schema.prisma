generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                   String            @id @default(cuid())
  name                 String?
  email                String?           @unique
  emailVerified        DateTime?
  image                String?           @db.LongText
  password             String?
  role                 Role              @default(DRIVER)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  discordNick          String?
  driverStatus         DriverStatus      @default(WAITING_FOR_APPROVAL)
  facebookUrl          String?
  firstName            String?
  monthlyLimitKm       Int               @default(10000)
  rank                 String            @default("Praktykant")
  steamUrl             String?
  totalDrivenKm        Int               @default(0)
  trucksBookUrl        String?
  trucksBookName       String?
  accountBalance       Float             @default(0)
  adrPermissions       Boolean           @default(false)
  drivingLicenseExpiry DateTime?
  medicalExamExpiry    DateTime?
  vacationDays         Int               @default(20)
  praises              Int               @default(0)
  reprimands           Int               @default(0)
  ecoScore             Float             @default(100)
  lastOnline           DateTime?
  initialDeliveries    Int               @default(0)
  initialMileage       Int               @default(0)
  notes                String?           @db.Text
  penaltyPoints        Int               @default(0)
  premium              Boolean           @default(false)
  premiumColor         String?
  probationPeriod      String?
  socialMedia          String?           @db.Text
  aboutMe              String?           @db.Text
  badges               String?           @db.LongText
  birthDate            DateTime?
  contractType         String?
  dispatcherRating     Float             @default(5)
  driverRating         Float             @default(5)
  reputationPoints     Int               @default(0)
  spotifyUrl           String?
  displayOrder         Int               @default(0)
  accounts             Account[]
  jobs                 Job[]
  requests             Request[]
  sessions             Session[]
  assignedTruck        Truck?            @relation("AssignedDriver")
  vehicleHistory       VehicleHistory[]
  bugReports           BugReport[]
  bankTransactions     BankTransaction[]
  chatMessages         ChatMessage[]
  announcements        Announcement[]
  casinoLogs           CasinoLog[]
  loans                Loan[]
  fuelLogs             FuelLog[]
  fuelCards            FuelCard[]
  chatReactions        ChatMessageReaction[]
  companyId            String?           @default("BMS")
  company              Company?          @relation(fields: [companyId], references: [id])
}

model Truck {
  id                String           @id @default(cuid())
  brand             String
  model             String
  plate             String           @unique
  mileage           Int              @default(0)
  status            TruckStatus      @default(AVAILABLE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  assignedDriverId  String?          @unique
  condition         Int              @default(100)
  fleetNumber       String           @unique
  imageUrl          String?
  lastUsedAt        DateTime?
  serviceLimitKm    Int              @default(80000)
  ownershipStatus   String           @default("Własność")
  inCompanySince    DateTime         @default(now())
  vin               String?
  location          String?
  averageFuel       Float            @default(0)
  cleanliness       Int              @default(100)
  fuelLevel         Float            @default(100)
  insuranceACExpiry DateTime?
  insuranceOCExpiry DateTime?
  attachedTrailerId String?          @unique
  power             Int              @default(500)
  productionYear    Int              @default(2020)
  tuningAllowed     Boolean          @default(true)
  type              String           @default("Ciągnik")
  jobs              Job[]
  requests          Request[]
  assignedDriver    User?            @relation("AssignedDriver", fields: [assignedDriverId], references: [id])
  attachedTrailer   Trailer?         @relation("AttachedTrailer", fields: [attachedTrailerId], references: [id])
  history           VehicleHistory[]
  fuelLogs          FuelLog[]
  leasing           Leasing?
  insurance         Insurance?
  baseId            String?
  companyBase       CompanyBase?     @relation(fields: [baseId], references: [id])
  assignedAt        DateTime?
  lastServiceKm     Int              @default(0)
  pendingBreakdown  String?          @db.Text
  companyId         String?          @default("BMS")
  company           Company?         @relation(fields: [companyId], references: [id])
}

model Trailer {
  id              String           @id @default(cuid())
  type            String
  plate           String           @unique
  status          String           @default("AVAILABLE")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  brand           String           @default("Krone")
  imageUrl        String?
  model           String           @default("Profi Liner")
  productionYear  Int              @default(2020)
  ownershipStatus String           @default("Własność")
  inCompanySince  DateTime         @default(now())
  mileage         Int              @default(0)
  attachedTruck   Truck?           @relation("AttachedTrailer")
  jobs            Job[]
  history         VehicleHistory[]
  insurance       Insurance?
  companyId       String?          @default("BMS")
  company         Company?         @relation(fields: [companyId], references: [id])
}

model VehicleHistory {
  id          String   @id @default(cuid())
  truckId     String?
  trailerId   String?
  type        String
  description String   @db.Text
  cost        Float?   @default(0)
  date        DateTime @default(now())
  userId      String?
  trailer     Trailer? @relation(fields: [trailerId], references: [id])
  truck       Truck?   @relation(fields: [truckId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@index([trailerId], map: "VehicleHistory_trailerId_fkey")
  @@index([truckId], map: "VehicleHistory_truckId_fkey")
  @@index([userId], map: "VehicleHistory_userId_fkey")
}

model Job {
  id                 String    @id @default(cuid())
  userId             String
  startCity          String
  endCity            String
  sourceCompany      String    @default("")
  destinationCompany String    @default("")
  cargo              String
  weight             Int       @default(0)
  distance           Int
  plannedDistance    Int       @default(0)
  income             Float?
  fuelConsumed       Float?
  driveTimeMinutes   Int?
  breakdowns         String    @default("Brak")
  averageFuel        Float?
  date               DateTime  @default(now())
  status             JobStatus @default(PENDING)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  description        String?   @db.Text
  dispatcherComment  String?   @db.Text
  summaryScreenshot  String    @db.LongText
  truckId            String?
  trailerId          String?
  truckScreenshot    String?   @db.LongText

  truck   Truck?   @relation(fields: [truckId], references: [id])
  trailer Trailer? @relation(fields: [trailerId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@index([truckId], map: "Job_truckId_fkey")
  @@index([trailerId], map: "Job_trailerId_fkey")
  @@index([userId], map: "Job_userId_fkey")
}

model Request {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  content   String   @db.Text
  status    String   @default("PENDING")
  truckId   String?
  cost      Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  truck     Truck?   @relation(fields: [truckId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([truckId], map: "Request_truckId_fkey")
  @@index([userId], map: "Request_userId_fkey")
}

enum Role {
  DRIVER
  DISPATCHER
  BOARD
  OWNER
}

enum DriverStatus {
  ACTIVE
  OFFLINE
  WAITING_FOR_APPROVAL
  SUSPENDED
  INACTIVE
  ON_ROUTE
  ON_LEAVE
}

enum JobStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TruckStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

model BugReport {
  id          String   @id @default(cuid())
  userId      String?
  title       String
  description String   @db.Text
  imageUrl    String?  @db.LongText
  status      String   @default("NEW") // NEW, IN_PROGRESS, RESOLVED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "BugReport_userId_fkey")
}

model BankTransaction {
  id     String   @id @default(cuid())
  userId String
  amount Float
  title  String
  date   DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CompanyTransaction {
  id          String   @id @default(cuid())
  type        String // INCOME, EXPENSE
  amount      Float
  category    String // np. Trasy, Paliwo, Pensje, Mandaty
  description String?
  date        DateTime @default(now())
  companyId   String?  @default("BMS")
  company     Company? @relation(fields: [companyId], references: [id])
}

model MonthlySettlement {
  id              String   @id @default(cuid())
  month           Int
  year            Int
  revenuePLN      Float
  fuelCost        Float
  ticketsCost     Float
  maintenanceCost Float
  salariesCost    Float
  otherCost       Float
  netProfit       Float
  isClosed        Boolean  @default(true)
  createdAt       DateTime @default(now())
  companyId       String?  @default("BMS")
  company         Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, month, year], map: "uq_monthly_settlement")
}

model Company {
  id              String   @id @default("BMS")
  name            String   @default("Bojar Logistic")
  logoUrl         String?
  description     String?  @db.Text
  isMain          Boolean  @default(false)
  revenuePerKmEur Float    @default(1.20)
  status          String   @default("ACTIVE")
  balance         Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  trucks          Truck[]
  trailers        Trailer[]
  transactions    CompanyTransaction[]
  settlements     MonthlySettlement[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text
  imageUrl  String?  @db.LongText
  audioUrl  String?  @db.LongText
  replyToId String?
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
  replyTo   ChatMessage? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   ChatMessage[] @relation("MessageReplies")
  reactions ChatMessageReaction[]

  @@index([userId])
  @@index([replyToId])
}

model ChatMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model Announcement {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model CasinoLog {
  id        String   @id @default(cuid())
  userId    String
  game      String   // ROULETTE, SLOTS
  betAmount Float
  winAmount Float
  result    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Loan {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  interest  Float
  totalDue  Float
  isPaid    Boolean  @default(false)
  createdAt DateTime @default(now())
  paidAt    DateTime?
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model FuelLog {
  id            String   @id @default(cuid())
  userId        String
  truckId       String
  country       String
  city          String
  liters        Float
  pricePerLiter Float
  totalCost     Float
  mileage       Int
  cardType      String?
  createdAt     DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id])
  truck         Truck    @relation(fields: [truckId], references: [id])

  @@index([userId])
  @@index([truckId])
}

model FuelCard {
  id         String   @id @default(cuid())
  userId     String
  cardNumber String   @unique
  type       String   // DKV, SHELL, E100
  issuedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Leasing {
  id                String   @id @default(cuid())
  totalValue        Float
  monthlyRate       Float
  buyoutPrice       Float
  totalCost         Float
  installmentsTotal Int      @default(24)
  startDate         DateTime @default(now())
  
  truckId           String   @unique
  truck             Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  
  payments          LeasingPayment[]
}

model LeasingPayment {
  id          String   @id @default(cuid())
  leasingId   String
  leasing     Leasing  @relation(fields: [leasingId], references: [id], onDelete: Cascade)
  amount      Float
  month       Int
  year        Int
  paidAt      DateTime @default(now())
  paidBy      String?  
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model Insurance {
  id                String   @id @default(cuid())
  type              String   // "OC/AC/Assistance", "OC", etc.
  yearlyCost        Float
  monthlyRate       Float
  validUntil        DateTime
  truckId           String?  @unique
  trailerId         String?  @unique
  
  truck             Truck?   @relation(fields: [truckId], references: [id], onDelete: Cascade)
  trailer           Trailer? @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  
  payments          InsurancePayment[]
}

model InsurancePayment {
  id          String   @id @default(cuid())
  insuranceId String
  insurance   Insurance @relation(fields: [insuranceId], references: [id], onDelete: Cascade)
  amount      Float
  month       Int
  year        Int
  paidAt      DateTime @default(now())
  paidBy      String?  
}

model CompanyBase {
  id              String   @id @default(cuid())
  name            String
  city            String
  monthlyCost     Float
  capacity        Int?     // NULL = bez limitu
  trucks          Truck[]
  payments        BasePayment[]
}

model BasePayment {
  id          String      @id @default(cuid())
  baseId      String
  base        CompanyBase @relation(fields: [baseId], references: [id], onDelete: Cascade)
  amount      Float
  month       Int
  year        Int
  paidAt      DateTime    @default(now())
  paidBy      String?
}

model ServiceInvoice {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  amount      Float
  status      String   @default("PENDING") // PENDING, PAID
  type        String   // SERVICE, TIRES, BREAKDOWN
  truckId     String?
  date        DateTime @default(now())
  paidAt      DateTime?
}

model IdempotencyKey {
  id           String   @id
  action       String   @db.VarChar(64)
  statusCode   Int
  responseBody String   @db.Text
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model MediaAsset {
  id        String   @id
  mimeType  String   @db.VarChar(64)
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
}


